# Server/build credentials belong in GitHub Actions Secrets, apps/worker/.dev.vars,
# or Wrangler secrets, never in PUBLIC_* or a committed .env file.
DATA_GO_KR_SERVICE_KEY=
BACKFILL_TOKEN=
D1_DATABASE_ID=
# This example is for the optional local Worker path. GitHub Pages-static uses
# live mode with an empty PUBLIC_API_BASE_URL and its Action-generated JSON.
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_DATA_MODE=fixture
# AdSense stays disabled until approval and a consent implementation are verified.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_AD_SLOT_RESULT=
PUBLIC_AD_SLOT_CONTENT=
PUBLIC_CONSENT_READY=false
