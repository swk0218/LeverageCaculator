# These two values belong in apps/worker/.dev.vars or Wrangler secrets, never in PUBLIC_*.
DATA_GO_KR_SERVICE_KEY=
BACKFILL_TOKEN=
D1_DATABASE_ID=
# Switch to live only after the Worker has a valid service key and D1 data.
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_DATA_MODE=fixture
# AdSense stays disabled until approval and a consent implementation are verified.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_AD_SLOT_RESULT=
PUBLIC_AD_SLOT_CONTENT=
PUBLIC_CONSENT_READY=false
