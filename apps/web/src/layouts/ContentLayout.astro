---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  intro?: string;
  noindex?: boolean;
}

const {title, description, intro, noindex = false} = Astro.props;
---

<BaseLayout title={`${title} · 양복음복`} description={description} noindex={noindex}>
  <article class="content-page page-shell">
    <header class="content-header">
      <h1>{title}</h1>
      {intro && <p>{intro}</p>}
    </header>
    <div class="content-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .content-page {
    padding: 64px 0 96px;
  }

  .content-header {
    max-width: 760px;
    padding-bottom: 32px;
    border-bottom: 2px solid var(--yb-border);
  }

  .content-header h1 {
    margin: 0;
    font-size: clamp(34px, 6vw, 56px);
    line-height: 1.12;
    letter-spacing: -0.055em;
  }

  .content-header p {
    max-width: 680px;
    margin: 16px 0 0;
    color: var(--yb-muted);
    font-size: 18px;
  }

  .content-body {
    max-width: 820px;
    padding-top: 40px;
  }

  .content-body :global(h2) {
    margin: 56px 0 14px;
    font-size: clamp(24px, 4vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.04em;
  }

  .content-body :global(h2:first-child) {
    margin-top: 0;
  }

  .content-body :global(h3) {
    margin: 30px 0 10px;
    font-size: 18px;
  }

  .content-body :global(p),
  .content-body :global(li) {
    color: color-mix(in srgb, var(--yb-ink) 80%, transparent);
  }

  .content-body :global(a) {
    font-weight: 750;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .content-body :global(.formula) {
    overflow-x: auto;
    padding: 18px 20px;
    border: 2px solid var(--yb-border);
    background: var(--yb-ink);
    color: var(--yb-surface);
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    box-shadow: var(--yb-shadow-small);
  }

  .content-body :global(.notice) {
    padding: 18px 20px;
    border-left: 6px solid var(--yb-accent);
    background: color-mix(in srgb, var(--yb-accent) 17%, var(--yb-surface));
  }

  .content-body :global(.content-table-wrap) {
    overflow-x: auto;
    border: 2px solid var(--yb-border);
    background: var(--yb-surface);
  }

  .content-body :global(table) {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 13px;
  }

  .content-body :global(th),
  .content-body :global(td) {
    padding: 13px 14px;
    border-bottom: 1px solid color-mix(in srgb, var(--yb-border) 24%, transparent);
    text-align: left;
    vertical-align: top;
  }

  .content-body :global(th) {
    background: var(--yb-ink);
    color: var(--yb-surface);
    white-space: nowrap;
  }

  .content-body :global(details) {
    border-top: 1px solid var(--yb-border);
  }

  .content-body :global(details:last-child) {
    border-bottom: 1px solid var(--yb-border);
  }

  .content-body :global(summary) {
    min-height: 60px;
    padding: 17px 40px 17px 0;
    font-weight: 850;
    cursor: pointer;
  }

  .content-body :global(details p) {
    padding: 0 0 20px;
    margin: 0;
  }

  @media (max-width: 620px) {
    .content-page {
      padding: 44px 0 72px;
    }

    .content-header p {
      font-size: 16px;
    }
  }
</style>
