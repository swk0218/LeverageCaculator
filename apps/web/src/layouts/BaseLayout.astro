---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { withSiteBase, withoutSiteBase } from '../lib/site-path';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title = '양복음복 · 레버리지 복리 계산기',
  description = '국내 레버리지·인버스 ETF와 ETN의 실제 손익, 본전 조건, 일일 복리효과를 계산합니다.',
  noindex = false,
  structuredData,
} = Astro.props;
const site = Astro.site ?? new URL('https://yangbokeumbok.example');
const canonical = new URL(withSiteBase(withoutSiteBase(Astro.url.pathname)), site);
const isPreview = (import.meta.env.PUBLIC_DATA_MODE ?? 'fixture') === 'fixture';
const robots = noindex || isPreview ? 'noindex,nofollow' : 'index,follow';
const adsEnabled =
  Boolean(import.meta.env.PUBLIC_ADSENSE_CLIENT) &&
  import.meta.env.PUBLIC_CONSENT_READY === 'true' &&
  !isPreview;
---

<!doctype html>
<html lang="ko" data-astryx-theme="neutral">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f6f7f9" />
    <title>{title}</title>
    {
      structuredData && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
    {
      adsEnabled && (
        <script
          is:inline
          async
          crossorigin="anonymous"
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
