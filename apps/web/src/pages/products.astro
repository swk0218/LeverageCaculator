---
import {PRODUCT_MASTER} from '@yangbok/contracts';

import ContentLayout from '../layouts/ContentLayout.astro';

const isFixture = (import.meta.env.PUBLIC_DATA_MODE ?? 'fixture') !== 'live';

const typeLabel = {
  stock: '현물 주식',
  'spot-index': '현물 지수',
  'futures-index': '선물 지수',
};

const baseIndexTypeLabel = {
  'price-return-index': '현물 가격지수(PR)',
  'futures-index': '선물지수',
  'total-return-index': '총수익지수(TR)',
};

const analysisScopeLabel = (product: (typeof PRODUCT_MASTER)[number]) =>
  product.analysisCapability !== 'full'
    ? '상품 손익만'
    : product.analysisBasis === 'reference-stock-proxy'
      ? '본주 환산 참고'
      : '본주 기준';

const productGroups = [
  {
    label: '삼성전자 상품',
    products: PRODUCT_MASTER.filter((product) => product.name.includes('삼성전자')),
  },
  {
    label: 'SK하이닉스 상품',
    products: PRODUCT_MASTER.filter((product) => product.name.includes('SK하이닉스')),
  },
];
---

<ContentLayout
  title="지원 상품"
  description="양복음복이 확인한 국내 상장 단일종목 레버리지·인버스 ETF/ETN과 공식 데이터 기준을 안내합니다."
  intro="삼성전자·SK하이닉스 연계 상품의 본전선과 복리효과를 계산합니다."
>
  <p class="notice">
    공식 상품 자료로 확인한 목록이며 상품 종가와 삼성전자(005930)·SK하이닉스(000660) 종가를 함께
    사용합니다. 선물 ETF와 TR형 ETN은 본주와 구조가 달라 ‘환산 참고’로 표시합니다.
  </p>

  <h2 id="confirmed-products-heading">지원 상품</h2>
  <div class="content-table-wrap" tabindex="0" role="region" aria-label="지원 상품 표">
    <table>
      <caption class="sr-only">종목코드, 상품명, 배수, 기준지수, 기준주식, 분석 범위</caption>
      <thead>
        <tr>
          <th scope="col">종목코드</th>
          <th scope="col">상품명</th>
          <th scope="col">배수</th>
          <th scope="col">상품·기준지수</th>
          <th scope="col">기준주식</th>
          <th scope="col">분석</th>
        </tr>
      </thead>
      <tbody>
        {
          PRODUCT_MASTER.map((product) => (
            <tr>
              <td class="tabular">{product.code}</td>
              <td>
                <a href={product.verification.evidenceUrl} target="_blank" rel="noreferrer">
                  {product.name}
                </a>
              </td>
              <td>{product.leverage > 0 ? `+${product.leverage}X` : `${product.leverage}X`}</td>
              <td>
                {product.productType} ·{' '}
                {product.baseIndexType
                  ? baseIndexTypeLabel[product.baseIndexType]
                  : typeLabel[product.underlyingType]}
                {product.baseIndexName && <small>{product.baseIndexName}</small>}
              </td>
              <td>{product.underlyingName}</td>
              <td>{analysisScopeLabel(product)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div
    class="product-group-list"
    role="region"
    aria-labelledby="confirmed-products-heading"
  >
    {
      productGroups.map((group, groupIndex) => (
        <details class="product-group" open={groupIndex === 0}>
          <summary>
            <span>{group.label}</span>
            <span>{group.products.length}개</span>
          </summary>
          <ul class="product-card-list">
            {group.products.map((product) => (
              <li>
                <div class="product-card-heading">
                  <div>
                    <strong>{product.name}</strong>
                    <span class="tabular">{product.code}</span>
                  </div>
                  <b>{product.leverage > 0 ? `+${product.leverage}X` : `${product.leverage}X`}</b>
                </div>
                <dl>
                  <div>
                    <dt>유형</dt>
                    <dd>
                      {product.productType} ·{' '}
                      {product.baseIndexType
                        ? baseIndexTypeLabel[product.baseIndexType]
                        : typeLabel[product.underlyingType]}
                    </dd>
                  </div>
                  <div>
                    <dt>기준지수</dt>
                    <dd>{product.baseIndexName ?? '상품 공식 자료 참고'}</dd>
                  </div>
                  <div>
                    <dt>기준주식</dt>
                    <dd>{product.underlyingName}</dd>
                  </div>
                  <div>
                    <dt>분석</dt>
                    <dd>{analysisScopeLabel(product)}</dd>
                  </div>
                </dl>
                <a href={product.verification.evidenceUrl} target="_blank" rel="noreferrer">
                  공식 근거 <span class="sr-only">(새 창)</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>

  <h2>공식 데이터</h2>
  <p>
    금융위원회 공공데이터에서 장 마감 후 가격을 가져와 검증한 뒤 제공합니다. 매수일·매수가·수량은
    전송하지 않으며, 새 응답이 비어 있거나 잘못되면 기존 정상 가격을 유지합니다.
  </p>

  <h2>기준일과 지연</h2>
  <p>
    현재가와 기준일을 함께 표시합니다. 상품과 본주 날짜가 다르면 최신 공통 거래일까지 분석하고,
    평일 기준 2일 이상 지난 데이터는 ‘업데이트 지연’으로 표시합니다.
  </p>

  {
    isFixture && (
      <>
        <h2>체험 데이터</h2>
        <p>
          로컬 모드에서는 정상·지연·기준일 불일치 상태를 확인할 예시 데이터를 사용합니다. 실제 시세가
          아니며 계산기 상단에 ‘체험 데이터’로 표시합니다.
        </p>
      </>
    )
  }
</ContentLayout>

<style>
  .product-group-list {
    display: none;
  }

  .content-table-wrap td small {
    display: block;
    margin-top: 4px;
    color: var(--yb-muted);
  }

  @media (max-width: 700px) {
    .content-table-wrap {
      display: none;
    }

    .product-group-list {
      display: grid;
      gap: 12px;
    }

    .product-group {
      overflow: hidden;
      border: 1px solid var(--yb-border);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.7);
    }

    .product-group > summary {
      display: flex;
      min-height: 56px;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 18px;
      color: var(--yb-ink);
      cursor: pointer;
      font-weight: 850;
      list-style-position: inside;
    }

    .product-group > summary span:last-child {
      color: var(--yb-muted);
      font-size: 13px;
      font-weight: 700;
    }

    .product-card-list {
      display: grid;
      gap: 12px;
      padding: 0;
      margin: 0 12px 12px;
      list-style: none;
    }

    .product-card-list > li {
      padding: 18px;
      border: 1px solid var(--yb-border);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.84);
      box-shadow: var(--yb-shadow-small);
    }

    .product-card-heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
    }

    .product-card-heading strong,
    .product-card-heading span {
      display: block;
    }

    .product-card-heading strong {
      color: var(--yb-ink);
      font-size: 15px;
      line-height: 1.45;
    }

    .product-card-heading span {
      margin-top: 4px;
      color: var(--yb-muted);
      font-size: 12px;
    }

    .product-card-heading b {
      flex: 0 0 auto;
      padding: 4px 9px;
      border-radius: 999px;
      background: var(--yb-accent-soft);
      color: var(--yb-accent-strong);
      font-size: 12px;
    }

    .product-card-list dl {
      display: grid;
      gap: 8px;
      margin: 16px 0;
    }

    .product-card-list dl > div {
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 10px;
    }

    .product-card-list dt {
      color: var(--yb-muted);
      font-size: 12px;
    }

    .product-card-list dd {
      margin: 0;
      color: var(--yb-ink);
      font-size: 13px;
    }

    .product-card-list a {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      color: var(--yb-accent-strong);
      font-size: 13px;
      font-weight: 800;
      text-underline-offset: 3px;
    }
  }
</style>
