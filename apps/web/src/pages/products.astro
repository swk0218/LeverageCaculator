---
import {PRODUCT_MASTER} from '@yangbok/contracts';

import ContentLayout from '../layouts/ContentLayout.astro';

const isFixture = (import.meta.env.PUBLIC_DATA_MODE ?? 'fixture') !== 'live';

const typeLabel = {
  stock: '현물 주식',
  'spot-index': '현물 지수',
  'futures-index': '선물 지수',
};

const baseIndexTypeLabel = {
  'price-return-index': '현물 PR 원지수',
  'futures-index': '선물 원지수',
  'total-return-index': 'TR 원지수',
};

const analysisScopeLabel = (product: (typeof PRODUCT_MASTER)[number]) =>
  product.analysisCapability !== 'full'
    ? '실제 손익만'
    : product.analysisBasis === 'reference-stock-proxy'
      ? '본주 환산 분석'
      : '본주 기준 분석';

const productGroups = [
  {
    label: '삼성전자 기반 상품',
    products: PRODUCT_MASTER.filter((product) => product.name.includes('삼성전자')),
  },
  {
    label: 'SK하이닉스 기반 상품',
    products: PRODUCT_MASTER.filter((product) => product.name.includes('SK하이닉스')),
  },
];
---

<ContentLayout
  title="지원 상품과 데이터 기준"
  description="양복음복이 확인한 국내 상장 단일종목 레버리지·인버스 ETF/ETN과 공식 데이터 기준을 안내합니다."
  intro="지원하는 전 상품에서 삼성전자·SK하이닉스 본주 기준 본전 가격과 복리효과를 확인할 수 있습니다."
>
  <p class="notice">
    아래 상품은 공식 상품 자료로 식별한 목록입니다. 상품 종가와 삼성전자(005930)·SK하이닉스(000660)
    종가를 함께 사용해 본전 조건과 복리효과를 계산합니다. 선물형과 TR형 ETN은 현물 본주와 정확히
    같지 않으므로 ‘본주 환산 참고’로 구분합니다.
  </p>

  <h2 id="confirmed-products-heading">확인된 상품</h2>
  <div class="content-table-wrap" tabindex="0" role="region" aria-label="확인된 상품 표">
    <table>
      <caption class="sr-only">종목코드, 상품명, 배수, 유형, 분석 기준주식, 분석 범위</caption>
      <thead>
        <tr>
          <th scope="col">종목코드</th>
          <th scope="col">상품명</th>
          <th scope="col">배수</th>
          <th scope="col">상품·일간 배수 산정 기준</th>
          <th scope="col">분석 기준주식</th>
          <th scope="col">분석 범위</th>
        </tr>
      </thead>
      <tbody>
        {
          PRODUCT_MASTER.map((product) => (
            <tr>
              <td class="tabular">{product.code}</td>
              <td>
                <a href={product.verification.evidenceUrl} target="_blank" rel="noreferrer">
                  {product.name}
                </a>
              </td>
              <td>{product.leverage > 0 ? `+${product.leverage}X` : `${product.leverage}X`}</td>
              <td>
                {product.productType} ·{' '}
                {product.baseIndexType
                  ? baseIndexTypeLabel[product.baseIndexType]
                  : typeLabel[product.underlyingType]}
                {product.baseIndexName && <small>{product.baseIndexName}</small>}
              </td>
              <td>{product.underlyingName}</td>
              <td>{analysisScopeLabel(product)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div
    class="product-group-list"
    role="region"
    aria-labelledby="confirmed-products-heading"
  >
    {
      productGroups.map((group, groupIndex) => (
        <details class="product-group" open={groupIndex === 0}>
          <summary>
            <span>{group.label}</span>
            <span>{group.products.length}개</span>
          </summary>
          <ul class="product-card-list">
            {group.products.map((product) => (
              <li>
                <div class="product-card-heading">
                  <div>
                    <strong>{product.name}</strong>
                    <span class="tabular">{product.code}</span>
                  </div>
                  <b>{product.leverage > 0 ? `+${product.leverage}X` : `${product.leverage}X`}</b>
                </div>
                <dl>
                  <div>
                    <dt>유형</dt>
                    <dd>
                      {product.productType} ·{' '}
                      {product.baseIndexType
                        ? baseIndexTypeLabel[product.baseIndexType]
                        : typeLabel[product.underlyingType]}
                    </dd>
                  </div>
                  <div>
                    <dt>일간 배수 산정 원지수</dt>
                    <dd>{product.baseIndexName ?? '상품 공식 자료 참고'}</dd>
                  </div>
                  <div>
                    <dt>분석 기준주식</dt>
                    <dd>{product.underlyingName}</dd>
                  </div>
                  <div>
                    <dt>분석 범위</dt>
                    <dd>{analysisScopeLabel(product)}</dd>
                  </div>
                </dl>
                <a href={product.verification.evidenceUrl} target="_blank" rel="noreferrer">
                  공식 근거 보기 <span class="sr-only">(새 창)</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>

  <h2>데이터 제공 방식</h2>
  <p>
    양복음복은 금융위원회 공공데이터를 장 마감 후 정기적으로 확인한 뒤 검증된 읽기 전용 가격
    정보만 브라우저에 제공합니다. 사용자가 입력한 매수일·매수가·수량은 이 과정에 전송하지
    않습니다. 새 응답이 비어 있거나 올바르지 않으면 기존 정상 가격을 덮어쓰지 않습니다.
  </p>

  <h2>가격 기준일과 지연 표시</h2>
  <p>
    현재가는 최신 공식 상품 종가와 기준일을 함께 표시합니다. 상품과 분석 기준주식의 날짜가 다르면 두
    시계열이 모두 존재하는 최신 공통 거래일까지 복리분석합니다. 평일 기준 2일 이상 오래된 데이터는
    화면에서 지연 상태로 표시합니다.
  </p>

  {
    isFixture && (
      <>
        <h2>체험용 데이터</h2>
        <p>
          로컬 체험 모드에서는 정상 +2X·-2X, 갱신 지연, 기준일 불일치와 부분 분석 상황을
          확인할 수 있는 예시 데이터를 사용합니다. 체험용 상품과 실제 시세를 혼동하지 않도록
          계산기 상단에 상태를 표시합니다.
        </p>
      </>
    )
  }
</ContentLayout>

<style>
  .product-group-list {
    display: none;
  }

  .content-table-wrap td small {
    display: block;
    margin-top: 4px;
    color: var(--yb-muted);
  }

  @media (max-width: 700px) {
    .content-table-wrap {
      display: none;
    }

    .product-group-list {
      display: grid;
      gap: 12px;
    }

    .product-group {
      overflow: hidden;
      border: 1px solid var(--yb-border);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.7);
    }

    .product-group > summary {
      display: flex;
      min-height: 56px;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 18px;
      color: var(--yb-ink);
      cursor: pointer;
      font-weight: 850;
      list-style-position: inside;
    }

    .product-group > summary span:last-child {
      color: var(--yb-muted);
      font-size: 13px;
      font-weight: 700;
    }

    .product-card-list {
      display: grid;
      gap: 12px;
      padding: 0;
      margin: 0 12px 12px;
      list-style: none;
    }

    .product-card-list > li {
      padding: 18px;
      border: 1px solid var(--yb-border);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.84);
      box-shadow: var(--yb-shadow-small);
    }

    .product-card-heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
    }

    .product-card-heading strong,
    .product-card-heading span {
      display: block;
    }

    .product-card-heading strong {
      color: var(--yb-ink);
      font-size: 15px;
      line-height: 1.45;
    }

    .product-card-heading span {
      margin-top: 4px;
      color: var(--yb-muted);
      font-size: 12px;
    }

    .product-card-heading b {
      flex: 0 0 auto;
      padding: 4px 9px;
      border-radius: 999px;
      background: var(--yb-accent-soft);
      color: var(--yb-accent-strong);
      font-size: 12px;
    }

    .product-card-list dl {
      display: grid;
      gap: 8px;
      margin: 16px 0;
    }

    .product-card-list dl > div {
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 10px;
    }

    .product-card-list dt {
      color: var(--yb-muted);
      font-size: 12px;
    }

    .product-card-list dd {
      margin: 0;
      color: var(--yb-ink);
      font-size: 13px;
    }

    .product-card-list a {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      color: var(--yb-accent-strong);
      font-size: 13px;
      font-weight: 800;
      text-underline-offset: 3px;
    }
  }
</style>
