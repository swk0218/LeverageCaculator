---
import AdSlot from '../components/AdSlot.astro';
import CalculatorIsland from '../features/calculator/CalculatorIsland';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSiteBase } from '../lib/site-path';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '단일종목 레버리지 계산기',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  isAccessibleForFree: true,
  description:
    '국내 레버리지·인버스 ETF와 ETN의 실제 손익, 본전 조건, 일일 복리효과를 계산하는 웹 도구',
};
---

<BaseLayout structuredData={structuredData}>
  <section class="intro page-shell">
    <div class="calculator-shell">
      <h1>레버리지로 얼마가 복사되고 녹았을까요?</h1>
      <p class="intro-lede">
        매수 내역을 입력하면 현재 손익, 본전에 필요한 주가와 복리효과를 계산합니다.
      </p>
    </div>
  </section>

  <section class="page-shell app-section" aria-label="단일종목 레버리지 계산기">
    <CalculatorIsland client:load />
  </section>

  <div class="page-shell">
    <AdSlot placement="result" />
  </div>

  <section class="page-shell support-links" aria-label="도움말">
    <nav>
      <a href={withSiteBase('/method')}>계산 원리</a>
      <span aria-hidden="true">·</span>
      <a href={withSiteBase('/faq')}>자주 묻는 질문</a>
    </nav>
    <AdSlot placement="content" />
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: 32px;
  }

  .intro .calculator-shell {
    padding: 0 8px;
  }

  .intro h1 {
    max-width: 760px;
    margin: 0;
    color: var(--yb-ink);
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.14;
    letter-spacing: -0.05em;
    text-wrap: balance;
    word-break: keep-all;
  }

  .intro-lede {
    max-width: 620px;
    margin: 8px 0 0;
    color: var(--yb-muted);
    font-size: 16px;
  }

  .app-section {
    padding-top: 20px;
  }

  .support-links {
    padding-top: 40px;
  }

  .support-links nav {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border-top: 1px solid var(--yb-border);
    color: var(--yb-muted);
  }

  .support-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--yb-accent-strong);
    font-size: 14px;
    font-weight: 750;
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .intro {
      padding-top: 24px;
    }

    .support-links {
      padding-top: 28px;
    }
  }
</style>
